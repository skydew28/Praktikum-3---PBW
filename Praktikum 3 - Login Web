<!DOCTYPE html>
<html>
  <head>
    <title>Login Mahasiswa!</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
      <h1 class="biru">LOGIN MAHASISWA</h1>
    <form action="" method="post"
      <form onsubmit="alert('Login Berhasil'); return false;">

  <label>Email</label><br>
  <input type="email" required><br><br>

  <label>Password</label><br>
  <input type="password" required><br><br>

  <button type="submit" style="background-color: #2f5a92;
  color: white;
  font-size: 18px;
  padding: 5px 15px;
  border: none;
  border-radius: 6px;
  font-weight: bold;">LOGIN</button>

  <button type="reset" style="background-color: #2f5a92;
  color: white;
  font-size: 18px;
  padding: 5px 15px;
  border: none;
  border-radius: 6px;
  font-weight: bold;">RESET</button>
</form>

</body>
</html>


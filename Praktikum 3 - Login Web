<!DOCTYPE html>
<html>
  <head>
    <title>Biodata Mahasiswa</title>
  </head>
  <body>
    <h1 class="biru">BIODATA MAHASISWA</h1>
    <h3 class="hijau">Isi biodata dibawah ini</h3>

    <form onsubmit="alert('Data Berhasil Disimpan!'); return false;">

      <label for="nim">NIM</label><br>
      <input type="text" id="nim" required><br><br>

      <label for="nama">Nama Lengkap</label><br>
      <input type="text" id="nama" required><br><br>

      <label for="email">Email</label><br>
      <input type="email" id="email" required><br><br>

      <label for="tgl_lahir">Tanggal Lahir</label><br>
      <input type="date" id="tgl_lahir" required><br><br>

      <label>Jenis Kelamin:</label><br>
      <input type="radio" id="laki" name="gender" value="Laki-laki" required>
      <label for="laki">Laki-laki</label><br>

      <input type="radio" id="perempuan" name="gender" value="Perempuan">
      <label for="perempuan">Perempuan</label><br><br>

      <button type="submit" style="background-color: #2f5a92;
      color: white; font-size: 18px;
      padding: 5px 15px;
      border: none;
      border-radius: 6px;
      font-weight: bold;">
      SIMPAN
      </button>

    </form>
  </body>
</html>

